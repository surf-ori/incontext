  <rdf:Description rdf:about="https://doi.org/10.5281/zenodo.3454688">
    <rdf:type rdf:resource="http://purl.utwente.nl/ns/escape-pubtypes.owl#Report"/>
    <dcterms:title>Open Scholarship and the need for collective action</dcterms:title>
    <dcterms:issued>2019</dcterms:issued>
    <dcterms:publisher>Knowledge Exchange</dcterms:publisher>
    <dcterms:abstract>Knowledge Exchange study on the economic and incentive challenges of the transition to open scholarship, using the KE Open Scholarship Framework of micro, meso and macro levels.</dcterms:abstract>
